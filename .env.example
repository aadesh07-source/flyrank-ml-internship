# Example environment variables — copy to .env and fill in real values.
# NEVER commit the actual .env file!

# Hugging Face read token for gated dataset access
HF_TOKEN=hf_your_token_here

# Salt for anonymizing page IDs (use a random string)
ANON_SALT=your-random-salt-string-here

# Python path to include backend modules
PYTHONPATH=./backend;backend
